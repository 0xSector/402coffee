# x402 network: "testnet" (Base Sepolia, keyless facilitator) or "mainnet" (Base, needs CDP key)
X402_NETWORK=testnet

# x402 protocol version advertised in challenges. Leave unset to default to 2 (validated
# against the live facilitator). Only override if the facilitator advertises otherwise.
# X402_VERSION=2

# Secret for SIWE nonce HMAC + webhook signing. REQUIRED. Generate: openssl rand -hex 32
SIWE_SECRET=

# Postgres. Local Docker example below; prod uses the Neon URL from the Vercel integration.
DATABASE_URL=postgres://dev:dev@localhost:5433/coffee402

# --- MAINNET ONLY (Coinbase CDP facilitator) ---
# Create at https://portal.cdp.coinbase.com -> API Keys. Required to settle real USDC on Base.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Public base URL (bakes into OG/metadata). Defaults to https://402coffee.com.
# BASE_URL=https://402coffee.com

# --- OPTIONAL ---
# Secures the reconciliation cron (Vercel sends it as a Bearer token). Recommended in prod.
# CRON_SECRET=
# Email tip notifications via Resend (dormant if unset — webhooks work without it).
# RESEND_API_KEY=
# NOTIFY_EMAIL_FROM=402 Coffee <tips@402coffee.com>
# Separate webhook signing secret (falls back to SIWE_SECRET).
# WEBHOOK_SIGNING_SECRET=
# Base RPC for reconciliation (defaults to https://mainnet.base.org).
# BASE_RPC_URL=
