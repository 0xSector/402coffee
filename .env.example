# x402 network: "testnet" (Base Sepolia, keyless facilitator) or "mainnet" (Base, needs CDP key)
X402_NETWORK=testnet

# x402 protocol version to advertise in challenges. Learn the right value from the
# facilitator's getSupported() (npm test prints it); leave unset to default to 1.
# X402_VERSION=1

# --- MAINNET ONLY (Coinbase CDP facilitator) ---
# Create at https://portal.cdp.coinbase.com -> API Keys. Required to settle real USDC on Base.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Public base URL of this deployment (bakes into resource URLs + widget). Set before slice 2.
# BASE_URL=https://<your-domain>

# Postgres (slice 1+). Not needed for slice 0 (JSON creator store).
# DATABASE_URL=
